# Pinned upstream versions. Sourced by scripts/*.sh.
# Policy: latest stable release of every component ("Bumping a version" in CLAUDE.md).

# QEMU — https://gitlab.com/qemu-project/qemu
QEMU_URL=https://gitlab.com/qemu-project/qemu.git
QEMU_REF=v11.1.3

# virglrenderer — https://gitlab.freedesktop.org/virgl/virglrenderer
VIRGLRENDERER_URL=https://gitlab.freedesktop.org/virgl/virglrenderer.git
VIRGLRENDERER_REF=virglrenderer-1.3.0

# libepoxy — https://github.com/anholt/libepoxy
# 1.5.10 is the newest release; the macOS EGL support merged later is carried
# as a backport in patches/libepoxy/.
LIBEPOXY_URL=https://github.com/anholt/libepoxy.git
LIBEPOXY_REF=1.5.10

# ANGLE — https://chromium.googlesource.com/angle/angle
# ANGLE has no releases; we follow the branch shipped by Chrome stable
# (chromium/<build> where Chrome is <milestone>.0.<build>.x).
# Updated by scripts/check-updates.sh.
ANGLE_CHROME_VERSION=156.0.8078.80
ANGLE_URL=https://chromium.googlesource.com/angle/angle
ANGLE_BRANCH=chromium/8078
ANGLE_REF=a66226b1d3c023ad3ff2c82a6782ba464629f27c

# depot_tools (needed only to sync and build ANGLE)
DEPOT_TOOLS_URL=https://chromium.googlesource.com/chromium/tools/depot_tools.git
DEPOT_TOOLS_REF=main

# QEMU system emulators to build
QEMU_TARGETS=aarch64-softmmu,x86_64-softmmu
